# PhishingGuard Forensic Platform Configuration (.env.example)
# Copy this file to .env and configure secret keys. Never commit .env to source control!

# Security & API Authentication
# Secret key required in 'X-API-Key' or 'Authorization: Bearer <token>' header for /api/forensics/*
FORENSIC_API_KEY=pg-forensic-secret-key-change-me-in-production

# Threat Intelligence APIs (Optional - offline fallback supported)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
URLSCAN_API_KEY=your_urlscan_api_key_here

# GeoIP Configuration (Optional - free offline database or ip-api fallback used)
MAXMIND_LICENSE_KEY=

# Allowed CORS Origins (comma-separated, default permits local & Chrome MV3 extensions)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,chrome-extension://*
